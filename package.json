{
  "name": "watch-together",
  "version": "0.0.0",
  "private": true,
  "description": "Provider-neutral protocol for synchronizing playback across compatible media clients",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "conformance",
    "packages/*",
    "reference-relay"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run check:repository && npm test",
    "check:repository": "node scripts/validate-repository.mjs",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
