{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:watch-together:manifest:v1",
  "title": "Watch Together service manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "canonicalOrigin",
    "protocolVersions",
    "endpoints",
    "operator",
    "privacy",
    "authentication",
    "capabilities"
  ],
  "properties": {
    "$schema": {
      "const": "urn:watch-together:manifest:v1"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$",
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "canonicalOrigin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^@/?#]+/?$"
    },
    "protocolVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "const": "1.0"
      }
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relayWebSocketUrl"
      ],
      "properties": {
        "relayWebSocketUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^wss://(?![^/?#]*@)[^?#]+$"
        },
        "accountLinkUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?![^/?#]*@)[^?#]+$"
        },
        "statusUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?![^/?#]*@)[^?#]+$"
        },
        "supportUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?![^/?#]*@)[^?#]+$"
        }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "websiteUrl"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "websiteUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?![^/?#]*@)[^?#]+$"
        },
        "contactUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?![^/?#]*@)[^?#]+$"
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyUrl",
        "contentBlind",
        "operationalDataCategories"
      ],
      "properties": {
        "policyUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?![^/?#]*@)[^?#]+$"
        },
        "contentBlind": {
          "const": true
        },
        "operationalDataCategories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "network_address",
              "account_identifier",
              "device_session_identifier",
              "room_display_name",
              "room_operational_metrics",
              "client_platform",
              "diagnostic_errors"
            ]
          }
        }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "guest"
      ],
      "properties": {
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "accountRequired"
          ],
          "properties": {
            "mode": {
              "enum": [
                "none",
                "email_otp_device_link"
              ]
            },
            "accountRequired": {
              "type": "boolean"
            }
          },
          "oneOf": [
            {
              "properties": {
                "mode": {
                  "const": "none"
                },
                "accountRequired": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "mode": {
                  "const": "email_otp_device_link"
                },
                "accountRequired": {
                  "const": true
                }
              }
            }
          ]
        },
        "guest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "accountRequired"
          ],
          "properties": {
            "mode": {
              "const": "room_credential"
            },
            "accountRequired": {
              "const": false
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "room.create",
          "room.join",
          "room.approve_guest",
          "room.rotate_invitation",
          "playback.pause",
          "playback.resume",
          "playback.seek",
          "participant.readiness",
          "round.readiness_gate",
          "round.countdown",
          "round.multiple",
          "source.local_offset"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": [
          "authentication"
        ],
        "properties": {
          "authentication": {
            "type": "object",
            "required": [
              "host"
            ],
            "properties": {
              "host": {
                "type": "object",
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "const": "email_otp_device_link"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "endpoints": {
            "type": "object",
            "required": [
              "accountLinkUrl"
            ],
            "properties": {
              "accountLinkUrl": {
                "$ref": "#/properties/endpoints/properties/accountLinkUrl"
              }
            }
          }
        }
      }
    }
  ]
}
